# Telegram
BOT_TOKEN=put_your_token_here
LOG_LEVEL=INFO

# Paths (defaults match project)
DATA_DIR=app/data
BOOKS_DIR=app/books

# TTS
TTS_BACKEND=edge  # edge|pyttsx3|none
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural
EDGE_TTS_VOICE_DEFAULT=en-US-JennyNeural
EDGE_TTS_VOICE_EN=en-US-JennyNeural
EDGE_TTS_VOICE_RU=ru-RU-SvetlanaNeural

# Limits
PAGE_LEN=1400
TTS_MAX_CHARS=1200
TTS_PAGES_AHEAD=10
TTS_MAX_PARTS=6
TTS_MAX_TOTAL_CHARS=6000

# --- System & Security ---
LOG_LEVEL=INFO
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
TUTOR_HISTORY_DEPTH=6
RECAP_STRIDE_PAGES=10
BOOK_CACHE_SIZE=16